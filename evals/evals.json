{
  "skill_name": "repo-to-resume",
  "schema_version": "2.0",
  "evals": [
    {
      "id": 1,
      "name": "真实实习-角色边界与STAR",
      "prompt": "我在一家电商公司实习，参与订单回调模块开发。mentor 定了整体方案，我实现了幂等校验和失败重试。帮我分析 C:\\work\\order-service 并做完整面试准备。",
      "expected_mode": "REAL_INTERNSHIP",
      "assertions": [
        {"id": "1.1", "text": "识别为真实实习模式", "check": "manifest.mode_equals:REAL_INTERNSHIP"},
        {"id": "1.1a", "text": "确认项目来源为实习", "check": "manifest.project_origin_equals:INTERNSHIP"},
        {"id": "1.2", "text": "生成项目分析和业务链路", "check": "files_exist:project-analysis.md,business-chains.md"},
        {"id": "1.3", "text": "区分 mentor 决策与用户实现", "check": "contribution_has_source:MENTOR_DIRECTED"},
        {"id": "1.4", "text": "简历动词匹配参与实现角色", "check": "resume_role_matches_manifest"},
        {"id": "1.5", "text": "每条核心 Bullet 有 claim ID", "check": "all_resume_bullets_have_claim_id"},
        {"id": "1.6", "text": "生成六层拷打报告", "check": "grill_has_layers:事实确认,个人角色,技术实现,方案对比,数据与验证,边界与复盘"},
        {"id": "1.7", "text": "生成最终质量门禁", "check": "file_exists:quality-gate-report.md"}
      ]
    },
    {
      "id": 2,
      "name": "弱实习-经历增强",
      "prompt": "我有两个月 Java 实习，但只写了几个 CRUD 和导出 Excel，感觉没什么能写。项目在 C:\\work\\energy-platform，帮我全部做完。",
      "expected_mode": "WEAK_INTERNSHIP",
      "assertions": [
        {"id": "2.1", "text": "识别为弱实习模式", "check": "manifest.mode_equals:WEAK_INTERNSHIP"},
        {"id": "2.1a", "text": "确认项目来源为实习", "check": "manifest.project_origin_equals:INTERNSHIP"},
        {"id": "2.2", "text": "CRUD 被放回端到端业务链路评估", "check": "business_chain_has_consumer"},
        {"id": "2.3", "text": "生成 1-3 个可执行增强任务", "check": "enhancement_task_count_between:1,3"},
        {"id": "2.4", "text": "任务包含方案、步骤、失败注入和验证", "check": "all_tasks_have:方案选项,执行步骤,失败注入,验证方法,完成证据,面试门禁"},
        {"id": "2.5", "text": "任务计划未自动当作已完成成果", "check": "planned_tasks_not_marked_implemented"},
        {"id": "2.6", "text": "高风险内容进入拷打", "check": "high_risk_claims_have_grill_result"}
      ]
    },
    {
      "id": 3,
      "name": "自研项目-企业化包装",
      "prompt": "我没有实习，自己做了一个 Go 支付服务。帮我分析 C:\\work\\go-payment，补齐工程亮点，写简历并准备面试。",
      "expected_mode": "SELF_PROJECT",
      "assertions": [
        {"id": "3.1", "text": "识别为自研项目模式", "check": "manifest.mode_equals:SELF_PROJECT"},
        {"id": "3.1a", "text": "确认项目来源为个人项目", "check": "manifest.project_origin_equals:SELF_OWNED"},
        {"id": "3.2", "text": "不要求虚构公司背景", "check": "resume_does_not_require_company"},
        {"id": "3.3", "text": "增强任务与核心链路关联", "check": "all_enhancements_have_chain_id"},
        {"id": "3.4", "text": "无数据时不凭组件推导百分比", "check": "no_component_based_performance_estimates"},
        {"id": "3.5", "text": "生成 15秒/30秒/2分钟/深挖材料", "check": "scripts_have_all_layers"},
        {"id": "3.6", "text": "学习路径按风险和重要度排序", "check": "learning_path_has_claim_gaps"}
      ]
    },
    {
      "id": 4,
      "name": "开源项目迁移-高风险门禁",
      "prompt": "我没实习也没项目，想用 https://github.com/expressjs/express 准备一段后端经历。帮我选核心内容、包装简历并准备到能面试。",
      "expected_mode": "PROJECT_MIGRATION",
      "assertions": [
        {"id": "4.1", "text": "识别为项目迁移模式", "check": "manifest.mode_equals:PROJECT_MIGRATION"},
        {"id": "4.1a", "text": "确认项目来源为开源项目", "check": "manifest.project_origin_equals:OPEN_SOURCE"},
        {"id": "4.2", "text": "选 1-3 条高价值链路而非全仓库冒领", "check": "migration_focus_chain_count_between:1,3"},
        {"id": "4.3", "text": "来源标记为复现、借用语境或叙事补全", "check": "claims_source_in:REPRODUCED,BORROWED_CONTEXT,NARRATIVE_FILL"},
        {"id": "4.4", "text": "生成复现、设计或叙事准备任务", "check": "enhancement_mode_in:REPRODUCED,DESIGNED,NARRATIVE_READY"},
        {"id": "4.5", "text": "高风险声明完成强化门禁", "check": "high_risk_gate_enforced"},
        {"id": "4.6", "text": "未通过时不虚报 Interview Ready", "check": "quality_status_respects_grill"}
      ]
    },
    {
      "id": 5,
      "name": "现有简历-反向找漏洞",
      "prompt": "这是实习项目，也是我现有简历中的经历：‘主导公司订单系统从0到1建设，使用 Redis 将性能提升 80%，支撑百万 QPS。’我只有项目代码 C:\\work\\orders，没有监控数据。帮我找漏洞并修到能面试。",
      "expected_mode": "EXISTING_RESUME",
      "assertions": [
        {"id": "5.1", "text": "识别为现有简历模式", "check": "manifest.mode_equals:EXISTING_RESUME"},
        {"id": "5.1a", "text": "现有简历仍记录底层项目来源", "check": "manifest.project_origin_equals:INTERNSHIP"},
        {"id": "5.2", "text": "识别角色和数字高风险", "check": "risk_flags_include:role_claim,numeric_claim"},
        {"id": "5.3", "text": "不保留无依据的百万 QPS 结论为低风险", "check": "unsupported_number_not_low_risk"},
        {"id": "5.4", "text": "允许保留草稿但强制拷打和补强", "check": "override_keeps_risk_and_training"},
        {"id": "5.5", "text": "生成明确修复任务", "check": "red_claim_has_repair_task"},
        {"id": "5.6", "text": "最终状态不虚报", "check": "quality_status_respects_evidence"}
      ]
    },
    {
      "id": 6,
      "name": "仅理解代码-不生成简历",
      "prompt": "我刚接手 C:\\work\\large-python-service，只想快速看懂，不要生成简历。只分析 src/，跳过测试和 vendor。",
      "expected_mode": "UNDERSTAND_ONLY",
      "assertions": [
        {"id": "6.1", "text": "识别为仅理解模式", "check": "manifest.mode_equals:UNDERSTAND_ONLY"},
        {"id": "6.2", "text": "限制分析范围", "check": "scope_equals:src"},
        {"id": "6.3", "text": "跳过测试和依赖", "check": "excluded:test,vendor"},
        {"id": "6.4", "text": "生成项目分析、业务链路和学习路径", "check": "files_exist:project-analysis.md,business-chains.md,learning-path.md"},
        {"id": "6.5", "text": "不生成简历和拷打报告", "check": "files_not_exist:resume.md,claim-grill-report.md"},
        {"id": "6.6", "text": "学习路径不依赖简历", "check": "learning_path_generated_without_resume"}
      ]
    }
  ],
  "global_assertions": [
    {"id": "G.1", "text": "所有引用文件存在", "check": "all_skill_references_exist"},
    {"id": "G.2", "text": "所有产物使用同一 manifest", "check": "single_manifest_contract"},
    {"id": "G.3", "text": "同名文件不覆盖", "check": "version_existing_outputs"},
    {"id": "G.4", "text": "异常有 if-then fallback", "check": "failure_modes_encoded"},
    {"id": "G.5", "text": "关键阶段有显式检查点", "check": "explicit_checkpoints_exist"},
    {"id": "G.6", "text": "存在反例黑名单", "check": "blacklist_exists"},
    {"id": "G.7", "text": "无单一 runtime 锁定", "check": "runtime_neutral"},
    {"id": "G.8", "text": "用户未回答时不生成虚构面试得分", "check": "no_fabricated_interview_scores"},
    {"id": "G.9", "text": "所有下游通过 current_artifacts 读取当前产物", "check": "current_artifact_routing_enforced"},
    {"id": "G.10", "text": "代码修改需要独立授权", "check": "code_mutation_gate_enforced"},
    {"id": "G.11", "text": "Manifest 执行结构与语义校验", "check": "manifest_semantic_validator_exists"},
    {"id": "G.12", "text": "中文成品执行语言一致性契约并保留必要技术名词", "check": "chinese_output_contract"},
    {"id": "G.13", "text": "代码价值优先于 Git 规模，候选池会用更强内容替换弱要点", "check": "code_first_value_selection_contract"},
    {"id": "G.14", "text": "生成或改写简历前必须确认项目来源", "check": "resume_requires_project_origin"}
  ]
}
